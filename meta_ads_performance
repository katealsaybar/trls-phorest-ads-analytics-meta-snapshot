<script>
function switchMetaTab(tab) {
  document.querySelectorAll('.meta-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.metaview').forEach(v => v.classList.remove('active'));
  document.getElementById('mtab-' + tab).classList.add('active');
  document.getElementById('metaview-' + tab).classList.add('active');
  if (tab === 'leads' && !chartsBuilt) buildCharts();
}

let chartsBuilt = false;

function buildCharts() {
  chartsBuilt = true;
  const ink = '#2D2E37', teal = '#0F6E56', coral = '#FF9B9B', amber = '#B45309', min = '#E8E5DD', gray = '#888780';

  new Chart(document.getElementById('metaSpendLeads'), {
    data: {
      labels: ['DF Lead Forms','F2/3 Retargeting','F1 UAE Mar','F1 Lookalikes','ABD F1 Feb','F2/3 ABD Feb','F1 DXB Feb','F2/3 DXB Feb'],
      datasets: [
        {type:'bar',label:'Spend (AED)',data:[8795,1235,728,441,503,360,665,290],backgroundColor:'rgba(45,46,55,0.8)',borderRadius:3,yAxisID:'y'},
        {type:'line',label:'Leads',data:[184,37,9,7,4,4,1,2],borderColor:teal,backgroundColor:'transparent',pointBackgroundColor:teal,pointRadius:5,pointHoverRadius:7,tension:0.3,yAxisID:'y2'}
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false}},scales:{x:{ticks:{font:{size:10},maxRotation:30},grid:{display:false},border:{color:min}},y:{position:'left',ticks:{font:{size:11},color:gray,callback:v=>'AED '+(v>=1000?(v/1000).toFixed(0)+'k':v)},grid:{color:min},border:{display:false}},y2:{position:'right',ticks:{font:{size:11},color:teal},grid:{display:false},border:{display:false}}}}
  });

  new Chart(document.getElementById('metaCPL'), {
    type:'bar',
    data:{
      labels:['DF Lead Forms','F2/3 Retargeting','F1 UAE Mar','F1 Lookalikes','ABD F1 Feb','F2/3 ABD Feb','F2/3 DXB Feb','F1 DXB Feb'],
