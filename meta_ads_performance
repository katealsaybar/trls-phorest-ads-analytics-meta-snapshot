<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meta Ads — Tara Rose Ladies Salon</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500&display=swap');
:root {
  --ink: #2D2E37; --ink-s: #363842; --cream: #FAF8F3; --mineral: #E8E5DD;
  --border: #D9D5CC; --white: #FFFFFF; --blush: #9B8EA0; --mid: #6B6870;
  --teal: #99F6E4; --teal-t: #0F6E56; --lav: #C4B5FD; --lav-t: #3C3489;
  --coral: #FF9B9B; --lime: #EEF3C7; --rose-acc: #FFD4D9;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Inter', sans-serif; background: var(--cream); color: var(--ink); font-size: 13px; }

.ads-content { padding: 36px 40px; max-width: 1200px; }

.ads-section-label {
  font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--ink); opacity: 0.45; margin: 1.75rem 0 0.65rem; display: block;
  border-bottom: 1.5px solid var(--ink); padding-bottom: 3px; width: fit-content;
}
.ads-section-label:first-child { margin-top: 0; }

.ads-metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-bottom: 8px; }
.ads-mc { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 0.85rem 1rem; }
.ads-ml { font-size: 11px; opacity: 0.5; margin: 0 0 3px; }
.ads-mv { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 400; margin: 0; line-height: 1.15; color: var(--ink); }
.ads-ms { font-size: 11px; opacity: 0.4; margin: 2px 0 0; }

.ads-card { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 10px; }

.ads-tbl { width: 100%; border-collapse: collapse; }
.ads-tbl thead td { font-size: 10px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; opacity: .4; padding: 0 0 8px; }
.ads-tbl tbody tr { border-top: 1px solid var(--mineral); }
.ads-tbl tbody td { padding: 8px 0; font-size: 13px; vertical-align: middle; color: var(--ink); }

.ads-bdg { font-size: 11px; padding: 2px 8px; border-radius: 20px; }
.ads-bpa { background: var(--mineral); opacity: .8; }
.ads-bac { background: var(--teal); color: var(--teal-t); }
.ads-cg { color: var(--teal-t); font-weight: 500; }
.ads-cb { color: #993C1D; font-weight: 500; }

.ads-leg { display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; opacity: .65; margin-bottom: 10px; }
.ads-leg span { display: flex; align-items: center; gap: 5px; opacity: 1; }
.ads-ld { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

.ads-two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.ads-ins { border-left: 2.5px solid var(--teal); padding: .65rem 1rem; margin: 5px 0; font-size: 13px; line-height: 1.65; background: var(--white); border-radius: 0 8px 8px 0; color: var(--ink); }
.ads-ins-w { border-left-color: var(--coral); }
.ads-ins-d { border-left-color: #e05050; background: #fff9f9; }
.ads-ins-g { border-left-color: var(--lav); }
.ads-ins-l { border-left-color: var(--lime); }

/* Sub-tabs */
.meta-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin: 20px 0 0; }
.meta-tab {
  padding: 8px 18px; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--mid); cursor: pointer;
  border-bottom: 2px solid transparent; transition: all 0.15s;
}
.meta-tab.active { color: var(--teal-t); border-bottom-color: var(--teal-t); }

.metaview { display: none; }
.metaview.active { display: block; }

@media (max-width: 900px) {
  .ads-two { grid-template-columns: 1fr; }
  .ads-content { padding: 24px 20px; }
}
</style>
</head>
<body>
<div class="ads-content">

  <span class="ads-section-label">Meta Ads — Jan–Apr 2026 overview</span>
  <div class="ads-metric-grid">
    <div class="ads-mc"><p class="ads-ml">Total spend</p><p class="ads-mv">AED 13,861</p><p class="ads-ms">All campaigns</p></div>
    <div class="ads-mc"><p class="ads-ml">Lead form leads</p><p class="ads-mv">237</p><p class="ads-ms">CPL AED 47.26</p></div>
