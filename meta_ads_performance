      <div class="ads-mc"><p class="ads-ml">Link clicks</p><p class="ads-mv">2,180</p><p class="ads-ms">CTR 1.51%</p></div>
      <div class="ads-mc"><p class="ads-ml">Landing pg. views</p><p class="ads-mv">22</p><p class="ads-ms" style="color:#993C1D;">1% of clicks ⚠</p></div>
    </div>

    <!-- CPM callout -->
    <span class="ads-section-label">Cost efficiency</span>
    <div class="ads-two">
      <div class="ads-card" style="display:flex;flex-direction:column;justify-content:center;">
        <div style="font-size:0.65rem;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;color:var(--mid);margin-bottom:6px;">IG awareness CPM</div>
        <div style="font-family:'Playfair Display',serif;font-size:2rem;color:var(--teal-t);">AED 5.83</div>
        <div style="font-size:0.72rem;color:var(--mid);margin-top:4px;">8–10× cheaper than lead form campaigns (avg AED 50 CPM)</div>
      </div>
      <div class="ads-card" style="display:flex;flex-direction:column;justify-content:center;">
        <div style="font-size:0.65rem;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;color:var(--mid);margin-bottom:6px;">Cost per profile visit</div>
        <div style="font-family:'Playfair Display',serif;font-size:2rem;color:var(--teal-t);">AED 0.43</div>
        <div style="font-size:0.72rem;color:var(--mid);margin-top:4px;">Cheapest brand touchpoint in the entire media mix</div>
      </div>
