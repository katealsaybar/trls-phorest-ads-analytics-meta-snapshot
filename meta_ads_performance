          <div style="position:relative;width:100%;height:130px;">
            <canvas id="metaTypeCompare" role="img" aria-label="Lead form 237 vs pixel 11 leads.">Lead type comparison.</canvas>
          </div>
          <div style="margin-top:16px;">
            <div style="font-size:0.7rem;font-weight:500;color:var(--mid);margin-bottom:8px;letter-spacing:0.06em;text-transform:uppercase;">CPL ratio</div>
            <div style="margin-bottom:8px;">
              <div style="display:flex;justify-content:space-between;font-size:0.72rem;margin-bottom:4px;"><span style="color:var(--ink);">Lead forms</span><span style="color:var(--teal-t);font-weight:500;">AED 47.26</span></div>
              <div style="height:8px;background:var(--mineral);border-radius:4px;overflow:hidden;"><div style="height:100%;width:29%;background:var(--teal-t);border-radius:4px;"></div></div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:0.72rem;margin-bottom:4px;"><span style="color:var(--ink);">Pixel tracking</span><span style="color:#993C1D;font-weight:500;">AED 165</span></div>
              <div style="height:8px;background:var(--mineral);border-radius:4px;overflow:hidden;"><div style="height:100%;width:100%;background:var(--coral);border-radius:4px;"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- DF Campaign Health -->
    <span class="ads-section-label">DF | Prospecting — campaign health</span>
    <div class="ads-card">
      <div style="font-size:0.72rem;color:var(--mid);margin-bottom:16px;">This single campaign generated 74% of all leads. It has stopped delivering — likely audience exhaustion after reaching 58,732 users.</div>
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0;align-items:center;">
