  new Chart(document.getElementById('metaTypeCompare'), {
    type:'doughnut',
    data:{
      labels:['Lead form (237)','Pixel (11)'],
      datasets:[{data:[237,11],backgroundColor:[ink,coral],borderWidth:3,borderColor:'#FAF8F3'}]
    },
    options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'right',labels:{font:{size:11},padding:10}}}}
  });
}

// Build charts on load since lead campaigns tab is active by default
buildCharts();
</script>
